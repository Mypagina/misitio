:root{--bg:#101114;--panel:#1a1b20;--gold:#d8b56d;--muted:#b9b7b1;--line:#38352e}
*{box-sizing:border-box}
body{margin:0;background:radial-gradient(circle at top,#29251e 0,#101114 48%);color:#f7f3ea;font-family:Arial,Helvetica,sans-serif;min-height:100vh}
header{text-align:center;padding:42px 18px 28px;border-bottom:1px solid var(--line)}
.brand{font-family:Georgia,serif;font-size:clamp(2.4rem,7vw,4.5rem);letter-spacing:.22em;color:var(--gold);margin:0}
.tagline{color:var(--muted);letter-spacing:.28em;text-transform:uppercase;font-size:.72rem;margin-top:12px}
main{width:min(920px,92%);margin:36px auto 70px}
.intro{text-align:center;color:var(--muted);margin:0 0 28px}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:15px}
.category{display:flex;align-items:center;justify-content:space-between;gap:12px;text-decoration:none;color:#f7f3ea;background:linear-gradient(135deg,#222329,#17181c);border:1px solid #464139;border-radius:12px;padding:22px 20px;transition:.2s}
.category:hover{border-color:var(--gold);transform:translateY(-2px);background:#25231f}
.category span:first-child{font-family:Georgia,serif;font-size:1.18rem}
.arrow{color:var(--gold);font-size:1.35rem}
.menu-card{background:rgba(26,27,32,.94);border:1px solid var(--line);border-radius:14px;padding:clamp(18px,4vw,32px);box-shadow:0 18px 50px #0005}
h2{font-family:Georgia,serif;color:var(--gold);text-align:center;letter-spacing:.16em;font-size:1.6rem;margin:0 0 24px}
.item{display:flex;justify-content:space-between;align-items:baseline;gap:18px;padding:13px 2px;border-bottom:1px solid #343238}
.item:last-child{border-bottom:0}
.name{color:#f3eee4;line-height:1.4}
.price{color:var(--gold);font-weight:700;white-space:nowrap}
.subhead{color:var(--gold);font-family:Georgia,serif;font-size:1.05rem;margin:22px 0 5px}
.back{display:inline-block;margin:0 0 20px;color:var(--gold);text-decoration:none}
.back:hover{text-decoration:underline}
.note{text-align:center;color:var(--muted);padding:24px 5px}
footer{text-align:center;color:#888;font-size:.8rem;padding:20px;border-top:1px solid var(--line)}
@media(max-width:420px){.item{gap:10px}.name{font-size:.94rem}.price{font-size:.94rem}}

